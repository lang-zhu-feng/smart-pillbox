# 复制为同目录 .env，再在本机填写。不要把真实 AppSecret 发到聊天或提交 Git。
# AppID 必须与微信开发者工具中当前小程序一致。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 填写该小程序实际可用的订阅消息模板 ID。
WECHAT_OVERDUE_TEMPLATE_ID=

# 必须对应实际模板的字段；不能直接把下面示例当作已配置。
# 示例：WECHAT_OVERDUE_FIELDS='{"name":"thing1","time":"time2","remark":"thing3"}'
# 当前实现要求 name、time、remark 三个键，且模板字段互不重复。
WECHAT_OVERDUE_FIELDS=

# 正式版 formal；体验版 trial；开发版 developer。按当前测试版本填写。
WECHAT_MINIPROGRAM_STATE=formal
