page {
  min-height: 100%;
  background: #fffaf3;
  color: #4d3c33;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button {
  box-sizing: border-box;
}

.page {
  padding: 28rpx 28rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(116, 77, 53, 0.06);
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 20rpx;
}

.section-title .title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-title .more {
  color: #b86c50;
  font-size: 25rpx;
}

.muted {
  color: #a18b77;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  border: 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0 30rpx;
}

.primary-btn {
  color: #ffffff;
  background: #b86c50;
}

.secondary-btn {
  color: #b86c50;
  background: #f4e6d8;
}

.danger-btn {
  color: #b34f3f;
  background: #fff0ed;
}

button::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 48rpx;
  border-radius: 24rpx;
  padding: 0 18rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.status-completed {
  color: #7d8569;
  background: #e9ecdf;
}

.status-confirmed {
  color: #517a77;
  background: #e3f1ee;
}

.status-reminding {
  color: #9a6505;
  background: #fff2cf;
}

.status-pending {
  color: #9b826c;
  background: #f0e8dd;
}

.status-overdue {
  color: #b34f3f;
  background: #fff0ed;
}

.status-none {
  color: #ad9985;
  background: #f4f0e9;
}

.status-offline {
  color: #6c7280;
  background: #eceef3;
}

.form-field{margin:22rpx 0}.form-field>text{display:block;color:#a18b77;font-size:23rpx;margin-bottom:12rpx}.form-field input,.picker-input{font-size:25rpx;padding:20rpx 22rpx;background:#fffaf3;border:1rpx solid #eadfd3;border-radius:18rpx;min-height:76rpx;height:auto}.form-field input{box-sizing:border-box}.form-error,.connection-error{font-size:22rpx;color:#b65d56;line-height:1.8;margin:16rpx 0}.connection-error{background:#f7e4db;padding:18rpx;border-radius:15rpx}.days-row{display:flex;flex-wrap:wrap;gap:16rpx}.days-row label{font-size:22rpx;display:flex;align-items:center}.days-row checkbox{transform:scale(.75)}.plan-form,.profile-form{margin-top:25rpx}.plan-form .primary-btn,.profile-form .primary-btn{width:100%}.status-tag{height:auto;min-height:48rpx;text-align:center}.info-row text:last-child{max-width:65%;text-align:right;word-break:break-all}.device-stats text{word-break:break-all}.form-note{font-size:22rpx;color:#a18b77;line-height:1.8;padding:20rpx 0}
