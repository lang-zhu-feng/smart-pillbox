page {
  min-height: 100%;
  background: #f4f7f6;
  color: #1d2b27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button {
  box-sizing: border-box;
}

.page {
  padding: 28rpx 28rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(36, 73, 63, 0.06);
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 20rpx;
}

.section-title .title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-title .more {
  color: #167a67;
  font-size: 25rpx;
}

.muted {
  color: #8a9692;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  border: 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0 30rpx;
}

.primary-btn {
  color: #ffffff;
  background: #167a67;
}

.secondary-btn {
  color: #167a67;
  background: #e9f5f1;
}

.danger-btn {
  color: #b34f3f;
  background: #fff0ed;
}

button::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 48rpx;
  border-radius: 24rpx;
  padding: 0 18rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.status-completed {
  color: #15745f;
  background: #e5f5ef;
}

.status-reminding {
  color: #9a6505;
  background: #fff2cf;
}

.status-pending {
  color: #49615a;
  background: #edf2f0;
}

.status-overdue {
  color: #b34f3f;
  background: #fff0ed;
}

.status-none {
  color: #9aa3a0;
  background: #f2f4f3;
}

.status-offline {
  color: #6c7280;
  background: #eceef3;
}
