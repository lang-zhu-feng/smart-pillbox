.support-title{font-size:40rpx;font-weight:700;margin-top:12rpx}.support-heading{font-size:30rpx;font-weight:700;margin-bottom:20rpx}.support-label{font-size:24rpx;color:#a18b77;margin-top:24rpx;margin-bottom:10rpx}.support-copy{display:block;white-space:pre-wrap;word-break:break-all;font-size:27rpx;line-height:1.8}.support-tip{font-size:26rpx;line-height:1.9;margin:14rpx 0}.support-page .secondary-btn,.support-page .primary-btn{margin-top:24rpx}.support-page textarea{box-sizing:border-box;width:100%;min-height:140rpx;background:#fffaf3;padding:20rpx;border:1rpx solid #eadfd3;border-radius:18rpx;font-size:26rpx;line-height:1.8}.support-page .choice{display:flex;align-items:flex-start;font-size:24rpx;line-height:1.8;margin:24rpx 0}.support-page .choice checkbox{flex-shrink:0;transform:scale(.8)}.source-button{background:transparent;color:#b86c50;font-size:22rpx;text-align:left;padding:8rpx 0;line-height:1.7}.support-empty{color:#a18b77;font-size:26rpx;line-height:1.8;padding:24rpx 0}.support-actions{display:flex;flex-wrap:wrap;gap:16rpx}.support-actions button{flex:1;min-width:180rpx}.chat-message{padding:20rpx;background:#f4eee7;border-radius:18rpx;margin:16rpx 0}.chat-message.mine{background:#f3dfd1}.chat-time{font-size:20rpx;color:#a18b77;margin-bottom:8rpx}
