.device-strip {
  display: flex;
  align-items: center;
  padding: 26rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1a7d6a, #3b9b87);
}

.device-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  font-weight: 700;
}

.device-copy {
  flex: 1;
  margin-left: 18rpx;
}

.device-name {
  font-size: 29rpx;
  font-weight: 700;
}

.device-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  opacity: 0.76;
}

.online-badge,
.offline-badge {
  padding: 9rpx 15rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 21rpx;
}

.online-badge text {
  display: inline-block;
  width: 11rpx;
  height: 11rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: #8df0b1;
}

.intro {
  padding: 28rpx 4rpx 18rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
}

.intro-copy {
  margin-top: 8rpx;
  color: #7c8985;
  font-size: 23rpx;
  line-height: 1.6;
}

.grid-scroll {
  width: 100%;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(36, 73, 63, 0.06);
}

.pill-grid {
  display: grid;
  grid-template-columns: 92rpx repeat(7, 104rpx);
  min-width: 820rpx;
  padding: 18rpx;
  gap: 10rpx;
}

.grid-corner,
.day-head,
.slot-head {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #71807b;
  font-size: 22rpx;
}

.day-head {
  flex-direction: column;
  border-radius: 16rpx;
}

.day-head text {
  margin-top: 3rpx;
  color: #167a67;
  font-size: 17rpx;
}

.today-head {
  color: #167a67;
  background: #eaf6f2;
  font-weight: 700;
}

.slot-head {
  flex-direction: column;
  border-radius: 16rpx;
  background: #f5f7f6;
  color: #344640;
  font-size: 25rpx;
  font-weight: 700;
}

.slot-head text {
  margin-top: 3rpx;
  color: #8a9692;
  font-size: 17rpx;
  font-weight: 400;
}

.pill-cell {
  min-height: 112rpx;
  padding: 14rpx 8rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pill-cell.today-cell {
  border-color: #58a994;
}

.cell-dot {
  width: 12rpx;
  height: 12rpx;
  margin-bottom: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.cell-label {
  font-size: 21rpx;
  font-weight: 700;
}

.cell-count {
  margin-top: 5rpx;
  font-size: 17rpx;
  opacity: 0.72;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 26rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  color: #60706b;
  font-size: 21rpx;
}

.legend-dot {
  width: 19rpx;
  height: 19rpx;
  min-width: 19rpx;
  min-height: 19rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.danger-btn {
  width: 100%;
  margin-top: 12rpx;
}

.tip {
  padding: 24rpx 10rpx;
  color: #8a9692;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
