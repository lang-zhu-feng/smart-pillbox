.auth-image{width:100%;display:block}.auth-main{padding:0 54rpx 50rpx;margin-top:-20rpx;position:relative;background:#fffaf3}.auth-brand{color:#b86c50;font-size:23rpx;letter-spacing:5rpx}.auth-title{font-size:46rpx;line-height:1.55;margin:20rpx 0}.auth-sub{font-size:23rpx;color:#a18b77;line-height:1.8}.auth-tabs{display:flex;justify-content:space-between;margin:35rpx 0;font-size:24rpx;color:#b69a83}.auth-tabs .selected{color:#b86c50;font-weight:700}.primary-btn,.secondary-btn{width:100%}.demo-login{margin-top:20rpx}.auth-privacy{text-align:center;color:#ad9984;font-size:20rpx;line-height:1.8;margin-top:26rpx}.server-link{font-size:20rpx;color:#a18b77;text-align:center;margin:30rpx 0;word-break:break-all}

.auth-title,.auth-privacy,.code{display:block;white-space:pre-line}
.connection-card{background:#f3e6d6;border-radius:22rpx;padding:24rpx;margin-top:24rpx;font-size:24rpx;color:#927159}.connection-address{font-size:24rpx;margin:14rpx 0;word-break:break-all}.connection-hint{font-size:21rpx;color:#a18b77;line-height:1.8;margin-top:12rpx}.connection-actions{display:flex;gap:40rpx;color:#b86c50;margin-top:18rpx;font-size:23rpx}.connection-check{margin-top:18rpx}.form-error{word-break:break-all}
.connection-error,.diagnostic-reason{word-break:break-all}.diagnostic-reason{font-size:20rpx;line-height:1.8;color:#9c7059;background:#f9f0e5;padding:16rpx;border-radius:12rpx}
.connection-actions{gap:18rpx}.connection-actions .secondary-btn{flex:1;font-size:23rpx;height:72rpx;line-height:72rpx;padding:0 15rpx;background:#ead5bf}.client-version{text-align:center;font-size:20rpx;color:#b5a18a;margin:18rpx 0}
