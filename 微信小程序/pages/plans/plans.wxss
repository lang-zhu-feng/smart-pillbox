.plan-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #276b85, #4399a2);
}

.summary-title {
  font-size: 32rpx;
  font-weight: 700;
}

.summary-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.78;
}

.plan-count {
  font-size: 54rpx;
  font-weight: 750;
}

.plan-count text {
  margin-left: 5rpx;
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.75;
}

.plan-card {
  position: relative;
  display: flex;
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(36, 73, 63, 0.05);
}

.plan-card.disabled {
  opacity: 0.58;
}

.plan-accent {
  width: 10rpx;
  background: #2c8a76;
}

.disabled .plan-accent {
  background: #a5aeab;
}

.plan-main {
  flex: 1;
  padding: 26rpx;
}

.plan-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.medicine-name {
  font-size: 30rpx;
  font-weight: 700;
}

.medicine-dose {
  margin-top: 7rpx;
  color: #84918d;
  font-size: 22rpx;
}

.schedule-row {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf1f0;
}

.time-box {
  width: 112rpx;
  height: 68rpx;
  border-radius: 18rpx;
  color: #167a67;
  background: #e8f5f1;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  line-height: 68rpx;
}

.schedule-copy {
  margin-left: 18rpx;
  color: #40514c;
  font-size: 24rpx;
}

.schedule-copy text {
  display: block;
  margin-top: 5rpx;
  color: #8a9692;
  font-size: 20rpx;
}

.add-btn {
  width: 100%;
  margin-top: 28rpx;
}

.form-note {
  padding: 24rpx 8rpx;
  color: #8a9692;
  font-size: 21rpx;
  line-height: 1.65;
  text-align: center;
}
