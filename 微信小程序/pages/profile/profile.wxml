<view class="page">
  <view class="connection-error" wx:if="{{connectionError}}">{{connectionError}}</view>
  <view class="profile-card">
    <view class="profile-avatar">家</view>
    <view class="profile-name">{{elder.name}}</view>
    <view class="profile-sub">{{elder.age}}岁 · {{elder.relation}} · {{elder.address}}</view>
    <view class="condition-row">
      <view class="condition" wx:for="{{elder.conditions}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="section-title">
    <view class="title">老人档案</view>
  </view>
  <view class="info-card">
    <view class="info-row"><text>姓名</text><text>{{elder.name}}</text></view>
    <view class="info-row"><text>年龄</text><text>{{elder.age}} 岁</text></view>
    <view class="info-row"><text>居住地址</text><text>{{elder.address}}</text></view>
    <view class="info-row"><text>紧急联系人</text><text>{{elder.emergencyContact}}</text></view>
  </view>

  <view class="section-title">
    <view class="title">绑定设备</view>
  </view>
  <view class="info-card">
    <view class="device-row">
      <view class="device-icon">药</view>
      <view class="device-main">
        <view class="device-name">{{device.name}}</view>
        <view class="device-code">{{device.code}}</view>
      </view>
      <view class="status-tag status-offline" bindtap="goDevice">{{deviceLabel}}</view>
    </view>
    <view class="device-stats">
      <view><text>{{device.battery == null ? '待上报' : device.battery + '%'}}</text><text>剩余电量</text></view>
      <view><text>{{device.lastSeen}}</text><text>最后通信</text></view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="goDevice"><view>硬件接入与设备设置</view><text>接入入口 ›</text></view>
    <view class="menu-item" bindtap="editProfile"><view>编辑家庭档案</view><text>编辑 ›</text></view>
    <view class="menu-item" bindtap="goHistory">
      <view>服药历史记录</view><text>›</text>
    </view>
    <view class="menu-item">
      <view>关于项目</view><text>课程 Demo</text>
    </view>
    <view class="menu-item" bindtap="logout"><view>退出登录</view><text>›</text></view>
  </view>
  <form wx:if="{{editOpen}}" class="card profile-form" bindsubmit="saveProfile">
    <view class="form-field"><text>家人称呼</text><input name="name" value="{{elder.name}}" maxlength="30"/></view>
    <view class="form-field"><text>年龄</text><input name="age" type="number" value="{{elder.age}}" maxlength="3"/></view>
    <view class="form-field"><text>关系</text><input name="relation" value="{{elder.relation}}" maxlength="12"/></view>
    <view class="form-field"><text>家的名字</text><input name="homeTitle" value="{{elder.homeTitle}}" maxlength="24"/></view>
    <view class="form-field"><text>居住地址</text><input name="address" value="{{elder.address}}" maxlength="100"/></view>
    <view class="form-field"><text>紧急联系人</text><input name="emergencyContact" value="{{elder.emergencyContact}}" maxlength="60"/></view>
    <button class="primary-btn" form-type="submit">保存家庭档案</button>
  </form>

  <button class="secondary-btn reset-btn" bindtap="resetDemo">重置全部演示数据</button>

  <view class="version">安心药伴 v0.2 · {{isDemo ? '演示家庭' : '独立家庭账号'}}
开盒不等于已服药</view>
</view>
