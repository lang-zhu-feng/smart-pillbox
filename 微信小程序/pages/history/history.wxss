.history-head {
  padding: 28rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #a97e61, #c7a283);
}

.head-title {
  font-size: 32rpx;
  font-weight: 700;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.78;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  padding: 26rpx 0 20rpx;
}

.filter-chip {
  padding: 14rpx 26rpx;
  border-radius: 24rpx;
  color: #9d8875;
  background: #eee3d6;
  font-size: 23rpx;
}

.filter-chip.active {
  color: #ffffff;
  background: #b86c50;
}

.record-card {
  display: flex;
  margin-bottom: 18rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(116, 77, 53, 0.05);
}

.record-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 750;
}

.record-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 700;
}

.record-medicine {
  margin-top: 12rpx;
  color: #816953;
  font-size: 24rpx;
}

.record-event {
  margin-top: 8rpx;
  color: #a18b77;
  font-size: 21rpx;
}

.empty {
  padding: 80rpx 0;
  color: #ad9985;
  font-size: 24rpx;
  text-align: center;
}

.boundary-note {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  color: #9b826c;
  background: #f2e6d8;
  font-size: 22rpx;
  line-height: 1.65;
}
