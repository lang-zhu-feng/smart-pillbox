<view class="page">
  <view class="hero">
    <view>
      <view class="hello">早上好，李女士</view>
      <view class="hero-sub">今天也一起守护父亲按时用药</view>
    </view>
    <view class="avatar">李</view>
  </view>

  <view class="elder-card">
    <view class="elder-top">
      <view>
        <view class="elder-name">{{elder.name}} <text>{{elder.age}}岁 · {{elder.relation}}</text></view>
        <view class="elder-condition">{{elder.conditionText}}</view>
      </view>
      <view class="device-online" wx:if="{{device.online}}"><text class="online-dot"></text>药盒在线</view>
      <view class="device-offline" wx:else>药盒离线</view>
    </view>
    <view class="summary-row">
      <view class="summary-main">
        <view class="summary-label">{{todayLabel}}服药进度</view>
        <view class="summary-value">{{completionText}}<text> 次</text></view>
      </view>
      <view class="progress-ring">
        <view class="ring-number">{{completionRate}}%</view>
        <view class="ring-label">完成率</view>
      </view>
    </view>
    <view class="progress-track">
      <view class="progress-value" style="width: {{completionRate}}%;"></view>
    </view>
  </view>

  <view class="alert-banner" wx:if="{{latestAlert}}" bindtap="goAlerts">
    <view class="alert-icon">!</view>
    <view class="alert-content">
      <view class="alert-title">{{latestAlert.title}}</view>
      <view class="alert-detail">{{latestAlert.detail}}</view>
    </view>
    <view class="alert-count" wx:if="{{unreadCount}}">{{unreadCount}}</view>
    <view class="arrow">›</view>
  </view>

  <view class="measure-card" wx:if="{{latestAlert}}">
    <view class="measure-title">处理措施</view>
    <view class="measure-text">先联系老人确认实际情况；多次联系未果，可联系社区联络员协助上门查看。</view>
    <view class="measure-note">开盒记录不能证明老人已经服药。</view>
  </view>

  <view class="section-title">
    <view class="title">今日用药</view>
    <view class="more" bindtap="goPillbox">查看本周药盒 ›</view>
  </view>

  <view class="task-list card">
    <view class="task-item" wx:for="{{todayTasks}}" wx:key="id">
      <view class="time-column">
        <view class="task-time">{{item.startTime}}</view>
        <view class="task-slot">{{item.slotFullName}}</view>
      </view>
      <view class="task-line">
        <view class="line-dot {{item.statusClass}}"></view>
        <view class="line-tail" wx:if="{{index < todayTasks.length - 1}}"></view>
      </view>
      <view class="task-main">
        <view class="medicine">{{item.medicineText}}</view>
        <view class="task-note" wx:if="{{item.completedAt}}">{{item.completedAt}} 检测到开盒事件</view>
        <view class="task-note" wx:else>{{item.time}}</view>
      </view>
      <view class="status-tag {{item.statusClass}}">{{item.statusLabel}}</view>
    </view>
  </view>

  <view class="section-title">
    <view class="title">快捷操作</view>
  </view>
  <view class="quick-grid">
    <view class="quick-item" bindtap="goHistory">
      <view class="quick-icon orange">记</view>
      <view class="quick-title">历史记录</view>
      <view class="quick-sub">查看开盒记录</view>
    </view>
    <view class="quick-item" bindtap="goAlerts">
      <view class="quick-icon red">醒</view>
      <view class="quick-title">异常提醒</view>
      <view class="quick-sub">{{unreadCount}} 条未读</view>
    </view>
  </view>

  <view class="boundary-note">
    <view class="boundary-title">说明</view>
    <view>“已完成”表示系统检测到对应药格的开盒事件，不代表医学意义上的确认服药。</view>
  </view>
</view>
